# Local dev: a plain SQLite file, no Turso account needed.
#
# In cPanel production, there's no need for a hosted Turso database either —
# "Setup Node.js App" runs this as a persistent process, so a local file
# works the same way. Point this at an absolute path OUTSIDE the app's
# deployed directory (a sibling folder in the cPanel account, e.g.
# /home/youruser/fk_olaine-data/app.db) so a redeploy never touches it —
# the parent directory is created automatically if it doesn't exist yet.
# Leave TURSO_AUTH_TOKEN empty in that case; it's only for a real Turso URL
# (libsql://...). Back the file up yourself (e.g. a cron copy) since a
# local file has no built-in replication.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Any string works locally. Use a long random value in production.
SESSION_SECRET=dev-only-secret-change-me

# The single shared admin password.
ADMIN_PASSWORD=change-me

# Where uploaded photos are written and served from — deliberately NOT
# under public/ (Next bakes public/ into a build-time static-files
# manifest, so a file written there after the last build 404s forever).
# src/app/uploads/[...path]/route.ts serves this directory live instead.
# Leave unset — it defaults to "./uploads", which .cpanel.yml symlinks to
# persistent external storage in production so uploads survive redeploys.
# UPLOADS_DIR=

# Shared secret for the /api/cron/sync-fixtures endpoint. Use a long random
# value in production; a cPanel Cron Job hits that URL with ?secret=<this>.
CRON_SECRET=dev-only-secret-change-me

# The site's real public URL in production (no trailing slash) — used to
# build absolute links in robots.txt/sitemap.xml. Leave as localhost in dev.
SITE_URL=http://localhost:3000

# SMTP credentials for outgoing notification emails (e.g. the LFF sync
# alerting an admin that a game's data needs review). In cPanel, go to
# Email Accounts, create/pick a mailbox (e.g. info@yourdomain.com), then
# click "Connect Devices" next to it — cPanel shows the exact host/port to
# use. Typically SMTP_HOST is mail.yourdomain.com, SMTP_PORT is 465 (SSL)
# or 587 (STARTTLS), SMTP_USER is the full email address, SMTP_PASSWORD is
# that mailbox's password. Leave all four unset to disable email sending —
# src/lib/mailer.ts skips it silently (just logs a warning) rather than
# failing whatever triggered the notification.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
